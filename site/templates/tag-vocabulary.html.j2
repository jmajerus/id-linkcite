{% extends 'base.html.j2' %}
{% block title %}{{ vocabulary.title }}{% endblock %}
{% block crumbs %}<span class="crumb">/ <a href="{{ patterns_home }}">{{ content.title }}</a></span>{% endblock %}
{% block main %}
{% macro chip(t) %}<li><a href="{{ t.href }}"{% if not count(t) %} class="unused"{% endif %}>{{ t.name }}{% if count(t) %} <span class="n">{{ count(t) }}</span>{% endif %}</a></li>{% endmacro %}
<div class="hero">
  <p class="kind"><span class="badge cluster">Tags</span></p>
  <h1>{{ vocabulary.title }}</h1>
  <p class="tagline">{{ vocabulary.blurb }}</p>
</div>
{% include '_resource-content.html.j2' %}
{% if hierarchical %}
  <section class="facet">
    <h2>In use</h2>
    <ul class="chips">{% for t in in_use %}{{ chip(t) }}{% endfor %}</ul>
  </section>
  <section class="facet">
    <h2>The full vocabulary</h2>
    <p class="blurb">How the catalog groups these tags, including those not yet on any pattern.</p>
    {% for t in top if narrower[t] %}
    <h3><a href="{{ t.href }}">{{ t.name }}</a></h3>
    <ul class="chips">{% for n in narrower[t] %}{{ chip(n) }}{% endfor %}</ul>
    {% endfor %}
  </section>
{% else %}
  <ul class="chips">{% for t in top %}{{ chip(t) }}{% endfor %}</ul>
{% endif %}
<p class="blurb fine">Numbers count the patterns with each tag. {{ used }} of the {{ total }} tags are on patterns so far.</p>
{% endblock %}
