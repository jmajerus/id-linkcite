{% extends 'base.html.j2' %}
{% macro item(p) %}
  <li class="pattern {{ p.kind }}">
    <a href="{{ p.href }}">{{ p.label }}</a>{% if p.provisional %} <span class="badge provisional">Provisional</span>{% endif %}
    {% if p.answered_by %}
    <span class="answer">Answered by {% for r in p.answered_by %}<a href="{{ r.href }}">{{ r.label }}</a>{{ ", " if not loop.last }}{% endfor %}</span>
    {% endif %}
    {% if p.answers %}
    <span class="answer">Answers {% for a in p.answers %}<a href="{{ a.href }}">{{ a.label }}</a>{{ ", " if not loop.last }}{% endfor %}</span>
    {% endif %}
  </li>
{% endmacro %}
{% macro group(g, heading) %}
  <section class="group" id="{{ g.id }}">
    <h3>{% if g.numeral %}<span class="numeral">{{ g.numeral }}</span> {% endif %}{% if g.href %}<a href="{{ g.href }}">{{ g.title }}</a>{% else %}{{ g.title }}{% endif %}</h3>
    {% if g.blurb %}<p class="blurb">{{ g.blurb }}</p>{% endif %}
    {% if g.note %}<div class="blurb">{{ g.note | md }}</div>{% endif %}
    {% for rule in g.scope_notes %}<p class="scope-note"><strong>What belongs here:</strong> {{ rule }}</p>{% endfor %}
    <ul class="patterns">
      {% for p in g.patterns %}{{ item(p) }}{% endfor %}
    </ul>
  </section>
{% endmacro %}

{% block title %}{{ content.title }}{% endblock %}
{% block crumbs %}<span class="crumb">/ {{ content.title }}</span>{% endblock %}

{% block main %}
<div class="hero">
  <h1>{{ content.title }}</h1>
  <p class="tagline">{{ content.tagline }}</p>
  <p class="counts">
    <span class="badge anti">{{ counts.anti }} anti-patterns</span>
    <span class="badge restorative">{{ counts.restorative }} restorative patterns</span>
    {% if version %}<span class="version">Catalog version {{ version }}</span>{% endif %}
  </p>
</div>

<div class="intro">{{ content.intro | md }}</div>

{% include '_resource-content.html.j2' %}

<aside class="note">
  <h2>{{ content.reading_title }}</h2>
  {{ content.reading | md }}
</aside>

<nav class="contents" aria-label="Contents">
  <h2>Contents</h2>
  <ol>
    <li><a href="#anti-patterns">Anti-patterns</a>
      <ol>
        {% for s in sections %}<li><a href="#{{ s.id }}">{{ s.numeral }}. {{ s.title }}</a></li>{% endfor %}
        {% for c in anti_clusters %}<li><a href="#{{ c.id }}">{{ c.title }}</a></li>{% endfor %}
      </ol>
    </li>
    <li><a href="#restorative-patterns">Restorative patterns</a>
      <ol>
        {% for c in restorative_clusters %}<li><a href="#{{ c.id }}">{{ c.title }}</a></li>{% endfor %}
      </ol>
    </li>
    {% if proposed %}<li><a href="#proposed">{{ content.proposed_title }}</a></li>{% endif %}
  </ol>
  <p class="browse">Browse by: {% for key, v in content.tags.items() %}<a href="{{ patterns_root }}/tags/{{ key }}">{{ v.title }}</a>{{ ' · ' if not loop.last }}{% endfor %}</p>
</nav>

<section class="part" id="anti-patterns">
  <h2 class="part-title anti">Anti-patterns</h2>
  <p class="part-intro">{{ content.anti_intro }}</p>
  {% for s in sections %}{{ group(s) }}{% endfor %}
  {% for c in anti_clusters %}{{ group(c) }}{% endfor %}
</section>

<section class="part" id="restorative-patterns">
  <h2 class="part-title restorative">Restorative patterns</h2>
  <p class="part-intro">{{ content.restorative_intro }}</p>
  <ul class="patterns">
    {% for p in restorative %}{{ item(p) }}{% endfor %}
  </ul>
  {% for c in restorative_clusters %}{{ group(c) }}{% endfor %}
</section>

{% if proposed %}
<section class="part" id="proposed">
  <h2 class="part-title">{{ content.proposed_title }}</h2>
  <p class="part-intro">{{ content.proposed }}</p>
  <ul class="patterns">
    {% for p in proposed %}{{ item(p) }}{% endfor %}
  </ul>
</section>
{% endif %}
{% endblock %}
