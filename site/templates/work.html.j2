{% extends 'base.html.j2' %}
{# A work's page: its vocabularies as cards. Navigation only; the work itself is not an identified resource. #}
{% block title %}{{ work.title }}{% endblock %}
{% block main %}
<div class="hero">
  <h1>{{ work.title }}</h1>
  <p class="tagline">{{ work.description }}</p>
</div>

<section class="part">
  <h2 class="part-title">Vocabularies</h2>
  <ul class="cards">
    {% for v in work.vocabularies %}
    <li class="card">
      <a href="{{ v.href }}">{{ v.title }}</a>
      <p><code class="iri-prefix">{{ v.iri }}/</code></p>
      <p class="tally">{{ v.resources }} resources</p>
    </li>
    {% endfor %}
  </ul>
</section>

{% if work.texts %}
<section class="part" id="texts">
  <h2 class="part-title">Read the annexes</h2>
  <ul class="texts">
    {% for t in work.texts %}
    <li>
      <a href="{{ t.href }}">{{ t.title }}</a> <span class="tally">PDF, {{ '%.1f' | format(t.bytes / 1048576) }} MB, built {{ t.built }}</span>
      <p>{{ t.description }}</p>
    </li>
    {% endfor %}
  </ul>
  {% if work.text_license %}<p class="fine">Prepublication drafts. Text licensed under <a href="{{ work.text_license.url }}" rel="license">{{ work.text_license.name }}</a>.</p>{% endif %}
</section>
{% endif %}
{% endblock %}
