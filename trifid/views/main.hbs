<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f77f00" />
  {{#if entityUrl}}<link rel="canonical" href="{{ entityUrl }}" />{{/if}}
  <title>{{#if entityLabel}}{{ entityLabel }} · {{/if}}{{ title }}</title>
  <link rel="stylesheet" href="{{subpath}}static/core/style.css" />
{{#each styles}}
  <link rel="stylesheet" href="{{ this }}" />
{{/each}}
  <link rel="shortcut icon" href="{{subpath}}static/core/favicon.ico" />
</head>

<body>
  {{#unless disableHeader}}
  {{{ header }}}
  {{/unless}}

  <main class="trifid-main">
    {{{ body }}}
  </main>

  {{#unless disableFooter}}
  {{{ footer }}}
  {{/unless}}

{{#each scripts}}
  <script src="{{ this }}"></script>
{{/each}}
</body>

</html>
