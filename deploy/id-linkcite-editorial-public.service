[Unit]
Description=LinkCite editorial public service (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
User=id-linkcite-public
Group=id-linkcite-public
WorkingDirectory=/opt/id-linkcite/current
# One root-only file for both units; drop the other role's secrets.
EnvironmentFile=/etc/linkcite/editorial.env
UnsetEnvironment=LINKCITE_EDITORIAL_EDITOR_DSN LINKCITE_EDITORIAL_USER LINKCITE_EDITORIAL_PASSWORD AUTHORING_DATABASE_URL
ExecStart=/opt/id-linkcite/editorial-venv/bin/python /opt/id-linkcite/current/editorial_service/server.py public
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
# libpq looks for ~/.postgresql/postgresql.crt; with ProtectHome=true the lookup fails with
# EACCES (fatal) instead of ENOENT (skipped). tmpfs hides /home but leaves it empty.
ProtectHome=tmpfs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
