[Unit]
Description=id.linkcite.org resolver (Trifid)
After=network.target id-linkcite-oxigraph.service
Wants=id-linkcite-oxigraph.service

[Service]
User=id-linkcite
Group=id-linkcite
WorkingDirectory=/opt/id-linkcite/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/id-linkcite/current/node_modules/trifid/dist/server.js --config trifid/config.yaml
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
