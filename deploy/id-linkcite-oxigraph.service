[Unit]
Description=id.linkcite.org triple store (Oxigraph, read-only, local only)
After=network.target

[Service]
User=id-linkcite
Group=id-linkcite
ExecStart=/usr/local/bin/oxigraph serve-read-only --location /var/lib/id-linkcite/store --bind 127.0.0.1:7879 --union-default-graph --timeout-s 30
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/id-linkcite

[Install]
WantedBy=multi-user.target
